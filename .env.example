APP_IMAGE=wlsh44/intervai-spring:latest
APP_PORT=8080
TZ=Asia/Seoul

SPRING_DATASOURCE_URL=jdbc:mysql://10.0.1.10:3306/intervai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
SPRING_DATASOURCE_USERNAME=intervai
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_JPA_HIBERNATE_DDL_AUTO=update

REDIS_HOST=10.0.1.11
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
APP_CORS_PROD_ALLOWED_ORIGINS=https://your-domain.com

JAVA_OPTS=-Xms256m -Xmx512m
